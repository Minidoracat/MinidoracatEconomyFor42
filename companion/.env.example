# 複製為 .env；留空的 ZOMBOID_DIR 使用目前使用者的 Zomboid 目錄。
ZOMBOID_DIR=
SERVER_NAME=servertest

# 日報依指定時區切日；輸出路徑相對執行時工作目錄。
REPORT_TIME_ZONE=Asia/Taipei
REPORT_OUTPUT_DIR=./reports

# 既有 companion 設定；日報沿用 POLL_MS 作存檔穩定確認間隔。
POLL_MS=2000
MAX_EVENTS_IN_MEMORY=200000
BIND=127.0.0.1
PORT=8477
# 正式 HTTP API 請填入私密金鑰；日報不透過 HTTP，也不需要此金鑰。
HMAC_SECRET=
